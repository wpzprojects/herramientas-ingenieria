rules_version = '2';

// Reglas de seguridad de Firestore para "Configuracion avanzada".
// Se pegan en Firebase Console > Firestore Database > Reglas > Publicar.
//
// Modelo de datos:
//   usuarios/{correo}                { rol: 'admin' | 'usuario', agregadoPor, fecha }   (el ID es el correo en minusculas)
//   usuarios/{correo}/secretos/gemini { clave }                                          (clave personal de Gemini)
//   ajustes/gemini                    { clave, actualizadoPor, fecha }                   (clave compartida de Gemini)
//   catalogos/{nombre}                { datos, version }                                 (catalogo completo: JSON en texto)
//   catalogos/_indice                 { catalogos: { nombre: { version, huellaFabrica, actualizadoPor, fecha, cambio,
//                                                               historial: [{ version, fecha, actualizadoPor, cambio }] } }, fecha }
//   catalogos_historial/{nombre}__{version} { nombre, datos, version }                 (ultimas 10 versiones, solo admin)
//   usuarios/{correo}/valoraciones/{id} { nombre, resumen, datos, creado, actualizado } (valoraciones integrales guardadas;
//                                                                                      solo las ve y cambia su dueño)
//
// Catalogos (2026-09-24): los LEE cualquiera, sin sesion (los visitantes usan calculadoras que dependen de ellos; la app
// los lee con la API REST, sin cargar el SDK) y solo los ESCRIBE un administrador. Ver js/util/catalogos-remotos.js.
//
// Quien tiene acceso: cualquier correo VERIFICADO por Google que tenga un documento en /usuarios.
// El primer administrador se crea a mano en la consola (la consola ignora estas reglas).
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function correo() {
      return request.auth.token.email.lower();
    }

    function esUsuario() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(correo()));
    }

    function esAdmin() {
      return esUsuario()
        && get(/databases/$(database)/documents/usuarios/$(correo())).data.rol == 'admin';
    }

    function usuarioValido(id) {
      return request.resource.data.keys().hasOnly(['rol', 'agregadoPor', 'fecha'])
        && request.resource.data.rol in ['admin', 'usuario']
        && id == id.lower()
        && id.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$');
    }

    match /usuarios/{id} {
      // Cualquiera con sesion puede leer SU PROPIO documento (asi se sabe si tiene acceso, sin error de permisos).
      // La lista completa y los documentos de otros correos solo los ve un administrador (privacidad de los correos).
      allow get: if autenticado() && (id == correo() || esAdmin());
      allow list: if esAdmin();

      // Solo un admin gestiona la lista. Un admin no puede quitarse ni bajarse el rol a si mismo:
      // asi siempre queda al menos un administrador.
      allow create: if esAdmin() && usuarioValido(id);
      allow update: if esAdmin() && usuarioValido(id)
                    && (id != correo() || request.resource.data.rol == 'admin');
      allow delete: if esAdmin() && id != correo();

      // Clave personal de Gemini: solo la lee/escribe su dueno (ni siquiera los admins).
      match /secretos/{doc} {
        allow read, write: if esUsuario() && id == correo();
      }

      // Valoraciones integrales guardadas (2026-09-25): solo su dueno las lee, crea, cambia y borra, y solo con la forma
      // esperada (el formulario va como texto JSON, con tamaño limitado).
      match /valoraciones/{vid} {
        allow read, delete: if esUsuario() && id == correo();
        allow create, update: if esUsuario() && id == correo()
          && vid.matches('^[A-Za-z0-9_-]{8,64}$')
          && request.resource.data.keys().hasOnly(['nombre', 'resumen', 'datos', 'creado', 'actualizado'])
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() > 0
          && request.resource.data.nombre.size() <= 120
          && request.resource.data.resumen is string
          && request.resource.data.resumen.size() <= 200
          && request.resource.data.datos is string
          && request.resource.data.datos.size() < 500000
          && request.resource.data.creado is number
          && request.resource.data.actualizado is number;
      }
    }

    // Clave compartida de Gemini: la leen los autorizados y solo la cambia un admin.
    match /ajustes/{doc} {
      allow read: if esUsuario();
      allow write: if esAdmin();
    }

    // Catalogos editables: lectura publica, escritura solo del admin y solo con la forma esperada.
    function catalogoConocido(id) {
      return id in ['conductores-desnudos', 'conductores-semiaislados', 'conductores-xlpe', 'tuberias', 'resoluciones'];
    }

    match /catalogos/{id} {
      allow read: if true;
      allow write: if esAdmin() && (
        (id == '_indice'
          && request.resource.data.keys().hasOnly(['catalogos', 'fecha'])
          && request.resource.data.catalogos is map
          && request.resource.data.catalogos.keys().hasOnly(['conductores-desnudos', 'conductores-semiaislados', 'conductores-xlpe', 'tuberias', 'resoluciones']))
        || (catalogoConocido(id)
          && request.resource.data.keys().hasOnly(['datos', 'version'])
          && request.resource.data.datos is string
          && request.resource.data.datos.size() < 1000000
          && request.resource.data.version is int)
      );
    }

    // Historial de versiones de cada catalogo (ultimas 10; la lista con fecha, autor y cambio vive en _indice). Solo
    // el administrador lo ve y lo escribe. El id es <nombre>__<version>.
    match /catalogos_historial/{id} {
      allow read, delete: if esAdmin();
      allow create: if esAdmin()
        && request.resource.data.keys().hasOnly(['nombre', 'datos', 'version'])
        && catalogoConocido(request.resource.data.nombre)
        && request.resource.data.version is int
        && id == request.resource.data.nombre + '__' + string(request.resource.data.version)
        && request.resource.data.datos is string
        && request.resource.data.datos.size() < 1000000;
    }
  }
}
